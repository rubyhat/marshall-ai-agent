{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubyhat/marshall-ai-agent/project-workflow.schema.json",
  "title": "Marshall AI Agent project workflow",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_kit",
    "project",
    "language",
    "interaction",
    "paths",
    "protection",
    "skills",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "workflow_kit": {
      "type": "object",
      "required": ["source", "revision", "installation_mode", "selected_modules"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "installation_mode": {
          "enum": ["centralized", "vendored", "symlink"]
        },
        "selected_modules": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["name", "product_type", "repositories"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "product_type": {"type": "string", "minLength": 1},
        "repositories": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "language": {
      "type": "object",
      "required": ["interaction", "project_docs", "internal_memory"],
      "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "required": ["clarifying_questions", "conflict_and_risk_gate"],
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["root_instructions", "project_docs", "internal_memory"],
      "properties": {
        "root_instructions": {"type": "string", "minLength": 1},
        "project_docs": {"type": "string", "minLength": 1},
        "internal_memory": {"type": "string", "minLength": 1},
        "project_topology": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {"type": "string"}
    },
    "protection": {
      "type": "object",
      "required": ["default_setup_boundary", "additional_restrictions"],
      "properties": {
        "default_setup_boundary": {"const": "enforced"},
        "additional_restrictions": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "output_contract": {
          "type": "object",
          "required": [
            "resolve_before_response",
            "explicit_user_form_precedence",
            "path_only_response_must_be_exact"
          ],
          "properties": {
            "resolve_before_response": {"const": true},
            "explicit_user_form_precedence": {"const": true},
            "path_only_response_must_be_exact": {"const": true}
          },
          "additionalProperties": true
        },
        "reports": {
          "type": "object",
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "chat_default": {"enum": ["chat", "file"]},
            "handoff_default": {"enum": ["chat", "file"]},
            "incident_default": {"enum": ["chat", "file"]},
            "file_response": {"enum": ["concise_link_or_path", "path_only"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "skills": {
      "type": "object",
      "required": ["active"],
      "properties": {
        "active": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "task_specs": {
      "type": "object",
      "properties": {
        "automatic_delivery": {
          "type": "object",
          "required": [
            "enabled",
            "capability",
            "require_content_verdict",
            "require_documentation_fast_path",
            "keep_task_open_after_merge",
            "issue_linkage"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "capability": {"const": "specification_documentation_delivery"},
            "require_content_verdict": {"const": "ready_for_implementation"},
            "require_documentation_fast_path": {"const": true},
            "keep_task_open_after_merge": {"const": true},
            "issue_linkage": {"const": "reference_only"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "properties": {
        "documentation_fast_path": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "allowed_roots": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "allowed_file_types": {
              "type": "array",
              "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"},
              "uniqueItems": true
            },
            "excluded_paths": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "require_all_changed_paths_eligible": {"const": true},
            "reject_executable_files": {"const": true},
            "reject_symlinks": {"const": true},
            "reject_generated_files": {"const": true},
            "reject_secret_or_temporary_files": {"const": true},
            "mixed_diff_falls_back_to_ordinary_review": {"const": true},
            "skip_independent_local_review": {"const": true},
            "skip_github_codex_review": {"const": true},
            "require_deterministic_validation": {"const": true},
            "deterministic_validation_binding": {"const": "head_and_base_sha"},
            "reported_checks_policy": {"const": "terminal_non_failing_when_present"},
            "no_checks_reported_is_blocker": {"const": false},
            "branch_protection_evidence_required": {"const": false},
            "never_bypass_provider_enforced_rules": {"const": true},
            "require_pull_request": {"const": true},
            "exact_pull_request_head_required": {"const": true}
          },
          "allOf": [
            {
              "if": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              },
              "then": {
                "required": [
                  "allowed_roots",
                  "allowed_file_types",
                  "excluded_paths",
                  "require_all_changed_paths_eligible",
                  "reject_executable_files",
                  "reject_symlinks",
                  "reject_generated_files",
                  "reject_secret_or_temporary_files",
                  "mixed_diff_falls_back_to_ordinary_review",
                  "skip_independent_local_review",
                  "skip_github_codex_review",
                  "require_deterministic_validation",
                  "deterministic_validation_binding",
                  "reported_checks_policy",
                  "no_checks_reported_is_blocker",
                  "branch_protection_evidence_required",
                  "never_bypass_provider_enforced_rules",
                  "require_pull_request",
                  "exact_pull_request_head_required"
                ],
                "properties": {
                  "allowed_roots": {"minItems": 1},
                  "allowed_file_types": {"minItems": 1}
                }
              }
            }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "required": [
        "aliases_are_plain_text",
        "aliases_do_not_expand_authority",
        "sequence_guard",
        "aliases"
      ],
      "properties": {
        "aliases_are_plain_text": {"const": true},
        "aliases_do_not_expand_authority": {"const": true},
        "authority_resolution": {
          "type": "object",
          "required": [
            "order",
            "sticky_negative_constraints_precede_alias_authority",
            "later_requests_may_narrow_but_not_implicitly_expand",
            "natural_language_requests_use_capability_gate",
            "authorized_handoffs_inherit_parent_capability_without_expansion"
          ],
          "properties": {
            "order": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "sticky_negative_constraints_precede_alias_authority": {"const": true},
            "later_requests_may_narrow_but_not_implicitly_expand": {"const": true},
            "natural_language_requests_use_capability_gate": {"const": true},
            "authorized_handoffs_inherit_parent_capability_without_expansion": {"const": true}
          },
          "additionalProperties": true
        },
        "session_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "lifetime",
              "sticky",
              "implicit_override_by_alias",
              "release"
            ],
            "properties": {
              "lifetime": {"type": "string", "minLength": 1},
              "sticky": {"const": true},
              "implicit_override_by_alias": {"const": false},
              "release": {"type": "string", "minLength": 1},
              "allowed_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "blocked_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        },
        "sequence_guard": {
          "type": "object",
          "required": [
            "enabled",
            "stop_before_mutation_on_mismatch",
            "report_current_state_and_unmet_prerequisite",
            "recommend_exact_next_alias_or_action"
          ],
          "properties": {
            "enabled": {"const": true},
            "stop_before_mutation_on_mismatch": {"const": true},
            "report_current_state_and_unmet_prerequisite": {"const": true},
            "recommend_exact_next_alias_or_action": {"const": true}
          },
          "additionalProperties": true
        },
        "aliases": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_specs": {
            "properties": {
              "automatic_delivery": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["automatic_delivery"]
          }
        },
        "required": ["task_specs"]
      },
      "then": {
        "required": ["delivery"],
        "properties": {
          "delivery": {
            "required": ["documentation_fast_path"],
            "properties": {
              "documentation_fast_path": {
                "properties": {
                  "enabled": {"const": true},
                  "allowed_roots": {"minItems": 1},
                  "allowed_file_types": {"minItems": 1}
                },
                "required": ["enabled", "allowed_roots", "allowed_file_types"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
