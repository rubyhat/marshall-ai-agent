{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubyhat/marshall-ai-agent/project-workflow.schema.json",
  "title": "Marshall AI Agent project workflow",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_kit",
    "project",
    "language",
    "interaction",
    "paths",
    "protection",
    "skills",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "workflow_kit": {
      "type": "object",
      "required": ["source", "revision", "installation_mode", "selected_modules"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "installation_mode": {
          "enum": ["centralized", "vendored", "symlink"]
        },
        "selected_modules": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["name", "product_type", "repositories"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "product_type": {"type": "string", "minLength": 1},
        "repositories": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "language": {
      "type": "object",
      "required": ["interaction", "project_docs", "internal_memory"],
      "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "required": ["clarifying_questions", "conflict_and_risk_gate"],
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["root_instructions", "project_docs", "internal_memory"],
      "properties": {
        "root_instructions": {"type": "string", "minLength": 1},
        "project_docs": {"type": "string", "minLength": 1},
        "task_specs": {"type": "string", "minLength": 1},
        "internal_memory": {"type": "string", "minLength": 1},
        "project_topology": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {"type": "string"}
    },
    "protection": {
      "type": "object",
      "required": ["default_setup_boundary", "additional_restrictions"],
      "properties": {
        "default_setup_boundary": {"const": "enforced"},
        "additional_restrictions": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "output_contract": {
          "type": "object",
          "required": [
            "resolve_before_response",
            "explicit_user_form_precedence",
            "path_only_response_must_be_exact"
          ],
          "properties": {
            "resolve_before_response": {"const": true},
            "explicit_user_form_precedence": {"const": true},
            "path_only_response_must_be_exact": {"const": true}
          },
          "additionalProperties": true
        },
        "reports": {
          "type": "object",
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "chat_default": {"enum": ["chat", "file"]},
            "handoff_default": {"enum": ["chat", "file"]},
            "incident_default": {"enum": ["chat", "file"]},
            "file_response": {"enum": ["concise_link_or_path", "path_only"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "planning_publication": {
      "type": "object",
      "required": [
        "quick_alias",
        "artifact_policy",
        "workspace",
        "independent_review",
        "readiness",
        "completion_gate"
      ],
      "properties": {
        "quick_alias": {
          "type": "object",
          "required": ["command", "capability", "exact_task_scope_only"],
          "properties": {
            "command": {"const": "--publish-spec"},
            "capability": {"const": "planning_artifact_publication"},
            "exact_task_scope_only": {"const": true}
          },
          "additionalProperties": true
        },
        "artifact_policy": {
          "type": "object",
          "required": [
            "default_spec_root",
            "ask_for_spec_root_when_default_is_available",
            "explicit_override_allowed",
            "implementation_changes_forbidden",
            "unrelated_changes_forbidden"
          ],
          "properties": {
            "default_spec_root": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
              "default": "docs_ai/tasks"
            },
            "ask_for_spec_root_when_default_is_available": {"const": false},
            "explicit_override_allowed": {"const": true},
            "implementation_changes_forbidden": {"const": true},
            "unrelated_changes_forbidden": {"const": true}
          },
          "additionalProperties": true
        },
        "workspace": {
          "type": "object",
          "required": ["isolated", "main_checkout_must_remain_clean"],
          "properties": {
            "isolated": {"const": true},
            "main_checkout_must_remain_clean": {"const": true}
          },
          "additionalProperties": true
        },
        "independent_review": {
          "type": "object",
          "required": [
            "required",
            "fresh_context",
            "author_self_check_is_not_independent",
            "working_directory",
            "working_directory_placeholder",
            "verify_reported_workdir_and_branch",
            "model",
            "effort",
            "max_correction_rounds",
            "committed_correction_review"
          ],
          "properties": {
            "required": {"const": true},
            "fresh_context": {"const": true},
            "author_self_check_is_not_independent": {"const": true},
            "working_directory": {
              "const": "exact_planning_worktree",
              "default": "exact_planning_worktree"
            },
            "working_directory_placeholder": {
              "const": "<PLANNING_WORKTREE>",
              "default": "<PLANNING_WORKTREE>"
            },
            "verify_reported_workdir_and_branch": {
              "const": true,
              "default": true
            },
            "model": {"type": "string", "minLength": 1},
            "effort": {
              "enum": ["low", "medium", "high", "xhigh"]
            },
            "max_correction_rounds": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "committed_correction_review": {
              "type": "object",
              "description": "Required dormant policy materialized during setup and activated only when a correction changes a publication manifest that already has an in-scope planning-branch commit.",
              "required": [
                "strategy",
                "checkpoint_commit_allowed",
                "deterministic_checks_before_checkpoint",
                "checkpoint_exact_manifest_only",
                "push_before_clean_review"
              ],
              "properties": {
                "strategy": {
                  "const": "local_checkpoint_committed_base_diff"
                },
                "checkpoint_commit_allowed": {"const": true},
                "deterministic_checks_before_checkpoint": {"const": true},
                "checkpoint_exact_manifest_only": {"const": true},
                "push_before_clean_review": {"const": false}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "readiness": {
          "type": "object",
          "required": [
            "input_content_verdict",
            "canonical_merge_required_before_implementation",
            "implementation_base_must_contain_publication_revision",
            "ordinary_publication_evidence"
          ],
          "properties": {
            "input_content_verdict": {"const": "spec_ready"},
            "canonical_merge_required_before_implementation": {"const": true},
            "implementation_base_must_contain_publication_revision": {
              "const": true,
              "description": "Require ancestry in the repository that owns the specification revision, not across unrelated Git histories."
            },
            "ordinary_publication_evidence": {
              "type": "object",
              "required": [
                "record_kind",
                "required_fields",
                "allowed_review_binding_methods",
                "complete_package_manifest_required",
                "reviewed_package_manifest_equals_merged",
                "persist_and_reread_before_cleanup"
              ],
              "properties": {
                "record_kind": {
                  "const": "reviewed_canonical_publication"
                },
                "required_fields": {
                  "const": [
                    "evidence_kind",
                    "task_id",
                    "specification_owner_repository",
                    "canonical_spec_path",
                    "pull_request_url",
                    "merged_revision",
                    "merged_tree_oid",
                    "reviewed_head_revision",
                    "reviewed_head_tree_oid",
                    "complete_reviewed_package_manifest",
                    "reviewer_evidence_identifier",
                    "reviewer_model",
                    "reviewer_effort",
                    "review_completed_at",
                    "terminal_clean_verdict",
                    "review_target_kind",
                    "canonical_base_revision",
                    "review_binding_method",
                    "reviewed_package_manifest_equals_merged"
                  ]
                },
                "allowed_review_binding_methods": {
                  "const": [
                    "direct_committed_base_diff",
                    "verified_uncommitted_manifest_equivalence"
                  ]
                },
                "complete_package_manifest_required": {"const": true},
                "reviewed_package_manifest_equals_merged": {"const": true},
                "persist_and_reread_before_cleanup": {"const": true}
              },
              "additionalProperties": true
            },
            "legacy_ready_adoption": {
              "type": "object",
              "default": {"enabled": false},
              "required": ["enabled"],
              "properties": {
                "enabled": {"type": "boolean", "default": false},
                "baseline_revision": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
                  "description": "Immutable full Git object ID for the canonical-target revision captured before planning-publication adoption; supports SHA-1 and SHA-256 repositories."
                },
                "baseline_must_be_ancestor_of_current_authority_base": {
                  "const": true,
                  "default": true
                },
                "evidence_mode": {
                  "const": "canonical_baseline_package_manifest",
                  "default": "canonical_baseline_package_manifest"
                },
                "current_package_manifest_must_match_baseline": {
                  "const": true,
                  "default": true
                },
                "persist_complete_baseline_package_manifest": {
                  "const": true,
                  "default": true
                },
                "ready_verdict_must_exist_at_baseline": {
                  "const": true,
                  "default": true
                },
                "derive_revision_from_last_spec_change_at_or_before_baseline": {
                  "const": true,
                  "default": true
                },
                "record_evidence_kind": {
                  "const": "legacy_ready_baseline",
                  "default": "legacy_ready_baseline"
                },
                "claim_independent_review": {
                  "const": false,
                  "default": false
                },
                "on_mismatch": {
                  "const": "publish_planning_change",
                  "default": "publish_planning_change"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"enabled": {"const": true}},
                    "required": ["enabled"]
                  },
                  "then": {
                    "required": [
                      "baseline_revision",
                      "baseline_must_be_ancestor_of_current_authority_base",
                      "evidence_mode",
                      "current_package_manifest_must_match_baseline",
                      "persist_complete_baseline_package_manifest",
                      "ready_verdict_must_exist_at_baseline",
                      "derive_revision_from_last_spec_change_at_or_before_baseline",
                      "record_evidence_kind",
                      "claim_independent_review",
                      "on_mismatch"
                    ]
                  }
                }
              ],
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "completion_gate": {
          "type": "object",
          "required": [
            "require_clean_independent_review",
            "require_clean_review_bound_to_published_package",
            "require_canonical_merge",
            "require_persisted_publication_record_readback",
            "implementation_issue_remains_open",
            "release_or_deploy_forbidden"
          ],
          "properties": {
            "require_clean_independent_review": {"const": true},
            "require_clean_review_bound_to_published_package": {"const": true},
            "require_canonical_merge": {"const": true},
            "require_persisted_publication_record_readback": {"const": true},
            "implementation_issue_remains_open": {"const": true},
            "release_or_deploy_forbidden": {"const": true}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "skills": {
      "type": "object",
      "required": ["active"],
      "properties": {
        "active": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "required": [
        "aliases_are_plain_text",
        "aliases_do_not_expand_authority",
        "sequence_guard",
        "aliases"
      ],
      "properties": {
        "aliases_are_plain_text": {"const": true},
        "aliases_do_not_expand_authority": {"const": true},
        "authority_resolution": {
          "type": "object",
          "required": [
            "order",
            "sticky_negative_constraints_precede_alias_authority",
            "later_requests_may_narrow_but_not_implicitly_expand",
            "natural_language_requests_use_capability_gate",
            "authorized_handoffs_inherit_parent_capability_without_expansion"
          ],
          "properties": {
            "order": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "sticky_negative_constraints_precede_alias_authority": {"const": true},
            "later_requests_may_narrow_but_not_implicitly_expand": {"const": true},
            "natural_language_requests_use_capability_gate": {"const": true},
            "authorized_handoffs_inherit_parent_capability_without_expansion": {"const": true}
          },
          "additionalProperties": true
        },
        "session_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "lifetime",
              "sticky",
              "implicit_override_by_alias",
              "release"
            ],
            "properties": {
              "lifetime": {"type": "string", "minLength": 1},
              "sticky": {"const": true},
              "implicit_override_by_alias": {"const": false},
              "release": {"type": "string", "minLength": 1},
              "allowed_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "blocked_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        },
        "sequence_guard": {
          "type": "object",
          "required": [
            "enabled",
            "stop_before_mutation_on_mismatch",
            "report_current_state_and_unmet_prerequisite",
            "recommend_exact_next_alias_or_action"
          ],
          "properties": {
            "enabled": {"const": true},
            "stop_before_mutation_on_mismatch": {"const": true},
            "report_current_state_and_unmet_prerequisite": {"const": true},
            "recommend_exact_next_alias_or_action": {"const": true}
          },
          "additionalProperties": true
        },
        "aliases": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow_kit": {
            "properties": {
              "selected_modules": {
                "contains": {"const": "publish-planning-change"}
              }
            }
          }
        }
      },
      "then": {
        "required": ["planning_publication"]
      }
    }
  ],
  "additionalProperties": true
}
