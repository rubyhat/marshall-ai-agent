{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubyhat/marshall-ai-agent/project-workflow.schema.json",
  "title": "Marshall AI Agent project workflow",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_kit",
    "project",
    "language",
    "interaction",
    "paths",
    "protection",
    "skills",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "workflow_kit": {
      "type": "object",
      "required": ["source", "revision", "installation_mode", "selected_modules"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "installation_mode": {
          "enum": ["centralized", "vendored", "symlink"]
        },
        "selected_modules": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["name", "product_type", "repositories"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "product_type": {"type": "string", "minLength": 1},
        "repositories": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "language": {
      "type": "object",
      "required": ["interaction", "project_docs", "internal_memory"],
      "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "required": ["clarifying_questions", "conflict_and_risk_gate"],
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["root_instructions", "project_docs", "internal_memory"],
      "properties": {
        "root_instructions": {"type": "string", "minLength": 1},
        "project_docs": {"type": "string", "minLength": 1},
        "internal_memory": {"type": "string", "minLength": 1},
        "project_topology": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {"type": "string"}
    },
    "protection": {
      "type": "object",
      "required": ["default_setup_boundary", "additional_restrictions"],
      "properties": {
        "default_setup_boundary": {"const": "enforced"},
        "additional_restrictions": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "output_contract": {
          "type": "object",
          "required": [
            "resolve_before_response",
            "explicit_user_form_precedence",
            "path_only_response_must_be_exact"
          ],
          "properties": {
            "resolve_before_response": {"const": true},
            "explicit_user_form_precedence": {"const": true},
            "path_only_response_must_be_exact": {"const": true}
          },
          "additionalProperties": true
        },
        "reports": {
          "type": "object",
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "chat_default": {"enum": ["chat", "file"]},
            "handoff_default": {"enum": ["chat", "file"]},
            "incident_default": {"enum": ["chat", "file"]},
            "file_response": {"enum": ["concise_link_or_path", "path_only"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "architecture_decisions": {
      "type": "object",
      "required": [
        "root",
        "index",
        "id_pattern",
        "filename_pattern",
        "status_mapping",
        "materiality_policy",
        "applicability_policy",
        "required_sections",
        "link_policy",
        "decision_authority",
        "mutation_policy"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[\\x00-\\x1F\\x7F])(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.?(?:[\\\\/]|$))(?!.*[\\\\/]$).+$"
        },
        "index": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[\\x00-\\x1F\\x7F])(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.?(?:[\\\\/]|$))(?!.*[\\\\/]$).+\\.md$"
        },
        "id_pattern": {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])(?:[A-Za-z][A-Za-z0-9_-]{0,30}-)?\\[0-9\\]\\{[1-9]\\}$"
        },
        "filename_pattern": {"const": "<ID>.md"},
        "status_mapping": {
          "type": "object",
          "required": [
            "proposed",
            "accepted",
            "rejected",
            "deprecated",
            "superseded"
          ],
          "properties": {
            "proposed": {"type": "string", "pattern": "\\S"},
            "accepted": {"type": "string", "pattern": "\\S"},
            "rejected": {"type": "string", "pattern": "\\S"},
            "deprecated": {"type": "string", "pattern": "\\S"},
            "superseded": {"type": "string", "pattern": "\\S"}
          },
          "additionalProperties": false
        },
        "materiality_policy": {"type": "string", "pattern": "\\S"},
        "applicability_policy": {
          "type": "object",
          "required": ["review_triggers", "blocking_results"],
          "properties": {
            "review_triggers": {
              "type": "array",
              "items": {"type": "string", "pattern": "\\S"},
              "uniqueItems": true,
              "minItems": 1
            },
            "blocking_results": {
              "type": "array",
              "items": {"enum": ["review required", "unclear"]},
              "uniqueItems": true,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "additionalProperties": true
        },
        "required_sections": {
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"},
          "uniqueItems": true,
          "minItems": 1
        },
        "link_policy": {
          "type": "object",
          "required": ["relative_links", "index_required"],
          "properties": {
            "relative_links": {"const": true},
            "index_required": {"const": true}
          },
          "additionalProperties": true
        },
        "decision_authority": {
          "type": "object",
          "required": [
            "propose",
            "accept",
            "reject",
            "clarify",
            "deprecate",
            "supersede"
          ],
          "properties": {
            "propose": {"type": "string", "pattern": "\\S"},
            "accept": {"type": "string", "pattern": "\\S"},
            "reject": {"type": "string", "pattern": "\\S"},
            "clarify": {"type": "string", "pattern": "\\S"},
            "deprecate": {"type": "string", "pattern": "\\S"},
            "supersede": {"type": "string", "pattern": "\\S"}
          },
          "additionalProperties": false
        },
        "mutation_policy": {
          "type": "object",
          "required": [
            "preview_required",
            "separate_confirmation_for",
            "accepted_material_changes_require_supersession"
          ],
          "properties": {
            "preview_required": {"type": "boolean"},
            "separate_confirmation_for": {
              "type": "array",
              "items": {
                "enum": [
                  "propose",
                  "accept",
                  "reject",
                  "clarify",
                  "deprecate",
                  "supersede"
                ]
              },
              "uniqueItems": true
            },
            "accepted_material_changes_require_supersession": {"const": true}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "skills": {
      "type": "object",
      "required": ["active"],
      "properties": {
        "active": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "required": [
        "aliases_are_plain_text",
        "aliases_do_not_expand_authority",
        "sequence_guard",
        "aliases"
      ],
      "properties": {
        "aliases_are_plain_text": {"const": true},
        "aliases_do_not_expand_authority": {"const": true},
        "authority_resolution": {
          "type": "object",
          "required": [
            "order",
            "sticky_negative_constraints_precede_alias_authority",
            "later_requests_may_narrow_but_not_implicitly_expand",
            "natural_language_requests_use_capability_gate",
            "authorized_handoffs_inherit_parent_capability_without_expansion"
          ],
          "properties": {
            "order": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "sticky_negative_constraints_precede_alias_authority": {"const": true},
            "later_requests_may_narrow_but_not_implicitly_expand": {"const": true},
            "natural_language_requests_use_capability_gate": {"const": true},
            "authorized_handoffs_inherit_parent_capability_without_expansion": {"const": true}
          },
          "additionalProperties": true
        },
        "session_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "lifetime",
              "sticky",
              "implicit_override_by_alias",
              "release"
            ],
            "properties": {
              "lifetime": {"type": "string", "minLength": 1},
              "sticky": {"const": true},
              "implicit_override_by_alias": {"const": false},
              "release": {"type": "string", "minLength": 1},
              "allowed_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "blocked_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        },
        "sequence_guard": {
          "type": "object",
          "required": [
            "enabled",
            "stop_before_mutation_on_mismatch",
            "report_current_state_and_unmet_prerequisite",
            "recommend_exact_next_alias_or_action"
          ],
          "properties": {
            "enabled": {"const": true},
            "stop_before_mutation_on_mismatch": {"const": true},
            "report_current_state_and_unmet_prerequisite": {"const": true},
            "recommend_exact_next_alias_or_action": {"const": true}
          },
          "additionalProperties": true
        },
        "aliases": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["workflow_kit"],
        "properties": {
          "workflow_kit": {
            "required": ["selected_modules"],
            "properties": {
              "selected_modules": {
                "contains": {"const": "record-architecture-decision"}
              }
            }
          }
        }
      },
      "then": {
        "required": ["architecture_decisions"]
      }
    }
  ],
  "additionalProperties": true
}
