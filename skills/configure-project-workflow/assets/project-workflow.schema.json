{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubyhat/marshall-ai-agent/project-workflow.schema.json",
  "title": "Marshall AI Agent project workflow",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_kit",
    "project",
    "language",
    "interaction",
    "paths",
    "protection",
    "skills",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "workflow_kit": {
      "type": "object",
      "required": ["source", "revision", "installation_mode", "selected_modules"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "installation_mode": {
          "enum": ["centralized", "vendored", "symlink"]
        },
        "selected_modules": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["name", "product_type", "repositories"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "product_type": {"type": "string", "minLength": 1},
        "repositories": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "language": {
      "type": "object",
      "required": ["interaction", "project_docs", "internal_memory"],
      "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "required": ["clarifying_questions", "conflict_and_risk_gate"],
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["root_instructions", "project_docs", "internal_memory"],
      "properties": {
        "root_instructions": {"type": "string", "minLength": 1},
        "project_docs": {"type": "string", "minLength": 1},
        "internal_memory": {"type": "string", "minLength": 1},
        "project_topology": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {"type": "string"}
    },
    "protection": {
      "type": "object",
      "required": ["default_setup_boundary", "additional_restrictions"],
      "properties": {
        "default_setup_boundary": {"const": "enforced"},
        "additional_restrictions": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "output_contract": {
          "type": "object",
          "required": [
            "resolve_before_response",
            "explicit_user_form_precedence",
            "path_only_response_must_be_exact"
          ],
          "properties": {
            "resolve_before_response": {"const": true},
            "explicit_user_form_precedence": {"const": true},
            "path_only_response_must_be_exact": {"const": true}
          },
          "additionalProperties": true
        },
        "reports": {
          "type": "object",
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "chat_default": {"enum": ["chat", "file"]},
            "handoff_default": {"enum": ["chat", "file"]},
            "incident_default": {"enum": ["chat", "file"]},
            "file_response": {"enum": ["concise_link_or_path", "path_only"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "context_loading": {
          "type": "object",
          "required": [
            "preflight_large_or_mixed_artifacts",
            "section_targeting_required_when_available",
            "full_read_requires_identified_semantic_need"
          ],
          "properties": {
            "preflight_large_or_mixed_artifacts": {"const": true},
            "section_targeting_required_when_available": {"const": true},
            "full_read_requires_identified_semantic_need": {"const": true}
          },
          "additionalProperties": true
        },
        "context_recording": {
          "type": "object",
          "required": [
            "canonical_current_state_only",
            "task_chronology_in_canonical_forbidden",
            "update_existing_owner_before_create"
          ],
          "properties": {
            "canonical_current_state_only": {"const": true},
            "task_chronology_in_canonical_forbidden": {"const": true},
            "update_existing_owner_before_create": {"const": true}
          },
          "additionalProperties": true
        },
        "context_maintenance": {
          "type": "object",
          "required": [
            "manual_only",
            "audit_before_cleanup",
            "exact_manifest_approval_required",
            "section_level_compaction_for_mixed_canonical",
            "diagnostic_metrics_are_not_retention_rules"
          ],
          "properties": {
            "manual_only": {"const": true},
            "audit_before_cleanup": {"const": true},
            "exact_manifest_approval_required": {"const": true},
            "section_level_compaction_for_mixed_canonical": {"const": true},
            "diagnostic_metrics_are_not_retention_rules": {"const": true}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "architecture_decisions": {
      "type": "object",
      "required": [
        "enabled",
        "root",
        "index",
        "id_pattern",
        "filename_pattern",
        "statuses",
        "decision_authority",
        "materiality_triggers",
        "supersession",
        "applicability_review",
        "bounded_exceptions",
        "retrospective_recording"
      ],
      "properties": {
        "enabled": {"const": true},
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?:(?!\\.\\.(?:[\\\\/]|$)).)+$"
        },
        "index": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?:(?!\\.\\.(?:[\\\\/]|$)).)+$"
        },
        "id_pattern": {
          "type": "string",
          "minLength": 1,
          "$comment": "scripts/validate_project_workflow_config.py conservatively proves that this regex emits one or more portable filename-safe ADR ID characters."
        },
        "filename_pattern": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?:(?!\\.\\.(?:[\\\\/]|$)).)*<ID>"
        },
        "statuses": {
          "type": "object",
          "$comment": "Distinct project labels are enforced by scripts/validate_project_workflow_config.py because standard JSON Schema cannot compare sibling property values.",
          "required": ["accepted", "superseded", "deprecated", "rejected"],
          "properties": {
            "proposed": {
              "anyOf": [
                {"type": "string", "minLength": 1},
                {"type": "null"}
              ]
            },
            "accepted": {"type": "string", "minLength": 1},
            "superseded": {"type": "string", "minLength": 1},
            "deprecated": {"type": "string", "minLength": 1},
            "rejected": {"type": "string", "minLength": 1}
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_authority": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "minItems": 1
        },
        "materiality_triggers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "minItems": 1
        },
        "supersession": {
          "type": "object",
          "required": ["material_change_creates_new_adr", "preserve_old_rationale"],
          "properties": {
            "material_change_creates_new_adr": {"const": true},
            "preserve_old_rationale": {"const": true}
          },
          "additionalProperties": true
        },
        "applicability_review": {
          "type": "object",
          "required": [
            "before_forcing_task_conformance",
            "stop_on_unclear_or_review_required",
            "review_triggers"
          ],
          "properties": {
            "before_forcing_task_conformance": {"const": true},
            "stop_on_unclear_or_review_required": {"const": true},
            "review_triggers": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "additionalProperties": true
        },
        "bounded_exceptions": {
          "type": "object",
          "required": [
            "allowed",
            "owner_required",
            "expiry_or_review_trigger_required"
          ],
          "properties": {
            "allowed": {"type": "boolean"},
            "owner_required": {"const": true},
            "expiry_or_review_trigger_required": {"const": true}
          },
          "additionalProperties": true
        },
        "retrospective_recording": {
          "type": "object",
          "required": [
            "allowed",
            "requires_verifiable_rationale",
            "bulk_creation_forbidden"
          ],
          "properties": {
            "allowed": {"type": "boolean"},
            "requires_verifiable_rationale": {"const": true},
            "bulk_creation_forbidden": {"const": true}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "skills": {
      "type": "object",
      "required": ["active"],
      "properties": {
        "active": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "required": [
        "aliases_are_plain_text",
        "aliases_do_not_expand_authority",
        "sequence_guard",
        "aliases"
      ],
      "properties": {
        "aliases_are_plain_text": {"const": true},
        "aliases_do_not_expand_authority": {"const": true},
        "authority_resolution": {
          "type": "object",
          "required": [
            "order",
            "sticky_negative_constraints_precede_alias_authority",
            "later_requests_may_narrow_but_not_implicitly_expand",
            "natural_language_requests_use_capability_gate",
            "authorized_handoffs_inherit_parent_capability_without_expansion"
          ],
          "properties": {
            "order": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "sticky_negative_constraints_precede_alias_authority": {"const": true},
            "later_requests_may_narrow_but_not_implicitly_expand": {"const": true},
            "natural_language_requests_use_capability_gate": {"const": true},
            "authorized_handoffs_inherit_parent_capability_without_expansion": {"const": true}
          },
          "additionalProperties": true
        },
        "session_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "lifetime",
              "sticky",
              "implicit_override_by_alias",
              "release"
            ],
            "properties": {
              "lifetime": {"type": "string", "minLength": 1},
              "sticky": {"const": true},
              "implicit_override_by_alias": {"const": false},
              "release": {"type": "string", "minLength": 1},
              "allowed_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "blocked_capabilities": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        },
        "sequence_guard": {
          "type": "object",
          "required": [
            "enabled",
            "stop_before_mutation_on_mismatch",
            "report_current_state_and_unmet_prerequisite",
            "recommend_exact_next_alias_or_action"
          ],
          "properties": {
            "enabled": {"const": true},
            "stop_before_mutation_on_mismatch": {"const": true},
            "report_current_state_and_unmet_prerequisite": {"const": true},
            "recommend_exact_next_alias_or_action": {"const": true}
          },
          "additionalProperties": true
        },
        "aliases": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow_kit": {
            "properties": {
              "selected_modules": {"contains": {"const": "load-project-context"}}
            }
          }
        }
      },
      "then": {
        "required": ["memory"],
        "properties": {"memory": {"required": ["context_loading"]}}
      },
      "else": {
        "not": {
          "required": ["memory"],
          "properties": {"memory": {"required": ["context_loading"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_kit": {
            "properties": {
              "selected_modules": {"contains": {"const": "record-project-context"}}
            }
          }
        }
      },
      "then": {
        "required": ["memory"],
        "properties": {"memory": {"required": ["context_recording"]}}
      },
      "else": {
        "not": {
          "required": ["memory"],
          "properties": {"memory": {"required": ["context_recording"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_kit": {
            "properties": {
              "selected_modules": {"contains": {"const": "maintain-project-context"}}
            }
          }
        }
      },
      "then": {
        "required": ["memory"],
        "properties": {"memory": {"required": ["context_maintenance"]}}
      },
      "else": {
        "not": {
          "required": ["memory"],
          "properties": {"memory": {"required": ["context_maintenance"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_kit": {
            "properties": {
              "selected_modules": {
                "contains": {"const": "record-architecture-decision"}
              }
            }
          }
        }
      },
      "then": {"required": ["architecture_decisions"]},
      "else": {"not": {"required": ["architecture_decisions"]}}
    }
  ],
  "additionalProperties": true
}
